#!/bin/sh
# Open tuber in a terminal (needed for TUI + xdg-open / magnet clicks).
# Magnets hand off to a running session; a bare launch opens/focuses the TUI.
BIN="${TUBER_BIN:-tuber}"

if [ "$#" -gt 0 ]; then
  if command -v "$BIN" >/dev/null 2>&1 || [ -x "$BIN" ]; then
    if "$BIN" --handoff "$@" >/dev/null 2>&1; then
      exit 0
    fi
  fi
fi

# Prefer foot on SweetPotatOs; kitty elsewhere.
if command -v foot >/dev/null 2>&1; then
  exec foot -T tuber -a tuber "$BIN" "$@"
fi
if command -v kitty >/dev/null 2>&1; then
  exec kitty --title tuber -d "${HOME}/Downloads/tuber" "$BIN" "$@"
fi
if command -v xdg-terminal-exec >/dev/null 2>&1; then
  exec xdg-terminal-exec "$BIN" "$@"
fi
exec "$BIN" "$@"
